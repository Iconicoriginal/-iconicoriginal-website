{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "iconicoriginal.it" }],
      "destination": "https://www.iconicoriginal.it/:path*",
      "permanent": true
    },
    { "source": "/sistema-modulare-iconic", "destination": "/sistema-modulare-magnetico/", "permanent": true },
    { "source": "/sistema-modulare-iconic/:rest*", "destination": "/sistema-modulare-magnetico/", "permanent": true },
    { "source": "/portfolio-item/:slug*", "destination": "/realizzazioni/", "permanent": true },
    { "source": "/portfolio_category/:slug*", "destination": "/realizzazioni/", "permanent": true },
    { "source": "/exhibitions", "destination": "/realizzazioni/", "permanent": true },
    { "source": "/exhibitions/:rest*", "destination": "/realizzazioni/", "permanent": true },
    { "source": "/stories", "destination": "/realizzazioni/", "permanent": true },
    { "source": "/stories/:rest*", "destination": "/realizzazioni/", "permanent": true },
    { "source": "/modulo-contatti", "destination": "/contatti/", "permanent": true },
    { "source": "/modulo-contatti/:rest*", "destination": "/contatti/", "permanent": true },
    { "source": "/sample-page", "destination": "/", "permanent": true },
    { "source": "/sample-page/:rest*", "destination": "/", "permanent": true },
    { "source": "/realizzazioni/page/:n", "destination": "/realizzazioni/", "permanent": true },
    { "source": "/category/:slug*", "destination": "/", "permanent": true },
    { "source": "/tag/:slug*", "destination": "/", "permanent": true },
    { "source": "/author/:slug*", "destination": "/chi-siamo/", "permanent": true },
    { "source": "/wp-content/:path*", "destination": "/", "permanent": true },
    { "source": "/wp-sitemap:rest*", "destination": "/sitemap.xml", "permanent": true },
    { "source": "/feed", "destination": "/", "permanent": true },
    { "source": "/feed/:rest*", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
